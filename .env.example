# Copy to .env and adjust. Never commit .env.
PORT=4000
# Local single-node replica set from docker-compose.yml (no auth, loopback only).
# 127.0.0.1, not localhost: on Windows Node resolves localhost to IPv6 ::1 first,
# but docker-compose publishes MongoDB on IPv4 127.0.0.1 only.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=fpl_rival_dev
NODE_ENV=development
JWT_SECRET=change-me
# Optional; defaults to the public FPL API.
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
