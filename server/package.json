{
  "name": "@fpl-radar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/contract/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "db:ping": "node --env-file-if-exists=../.env scripts/dbPing.js",
    "fpl:smoke": "node scripts/fplSmoke.js"
  },
  "dependencies": {
    "bottleneck": "2.19.5",
    "express": "5.2.1",
    "lru-cache": "11.5.3",
    "mongoose": "9.10.2",
    "zod": "4.6.5"
  }
}
