{
  "name": "@fpl-radar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/contract/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "db:ping": "node --env-file-if-exists=../.env scripts/dbPing.js",
    "fpl:smoke": "node scripts/fplSmoke.js",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "auth:hash": "node scripts/hashPassword.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bottleneck": "2.19.5",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "9.0.3",
    "lru-cache": "11.5.3",
    "mongoose": "9.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.32",
      "disablePostinstall": "1"
    }
  }
}
