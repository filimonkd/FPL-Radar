{
  "name": "fpl-radar",
  "version": "0.0.0",
  "private": true,
  "description": "FPL Radar monorepo (server + client)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w server",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:ping": "npm run db:ping -w server"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
