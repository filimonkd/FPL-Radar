{
  "name": "fpl-radar",
  "version": "0.0.0",
  "private": true,
  "description": "FPL Radar monorepo (server + client)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "test": "npm test --workspaces --if-present",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:status": "docker compose exec mongo mongosh --quiet --eval \"rs.status().members.map(m => ({ name: m.name, state: m.stateStr }))\""
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
